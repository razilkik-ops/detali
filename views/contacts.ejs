<%- include('partials/head') %>
<%- include('partials/header') %>
<main id="main">
  <section class="simple-hero">
    <div class="container reveal">
      <nav class="breadcrumbs" aria-label="Хлебные крошки"><a href="/">Главная</a><i class="bi bi-chevron-right" aria-hidden="true"></i><span>Контакты</span></nav>
      <span class="eyebrow light">Связаться с производством</span>
      <h1>Обсудим вашу <span>задачу</span></h1>
      <p>Оставьте заявку через форму или позвоните и кратко опишите деталь, материал, количество и желаемый срок.</p>
    </div>
  </section>
  <section class="section contact-page">
    <div class="container contact-page-grid">
      <div class="contact-details reveal">
        <span class="eyebrow">Контакты</span><h2><%= company.legalName %></h2>
        <a class="contact-detail" href="<%= company.addressUrl %>" target="_blank" rel="noopener noreferrer"><i class="bi bi-geo-alt" aria-hidden="true"></i><div><small>Юридический адрес — открыть карту</small><strong><%= company.postalCode %>, <%= company.address %></strong></div></a>
        <div class="contact-detail"><i class="bi bi-phone" aria-hidden="true"></i><div><small><%= company.mobileName %></small><a href="tel:<%= company.mobileHref %>"><%= company.mobile %></a></div></div>
        <div class="contact-detail"><i class="bi bi-telephone" aria-hidden="true"></i><div><small><%= company.phoneName %></small><a href="tel:<%= company.phoneHref %>"><%= company.phone %></a></div></div>
        <div class="contact-detail"><i class="bi bi-envelope" aria-hidden="true"></i><div><small>E-mail для заявок и чертежей</small><a href="mailto:<%= company.email %>"><%= company.email %></a></div></div>
        <div class="requisites"><h3>Реквизиты</h3><dl><div><dt>УНП</dt><dd><%= company.unp %></dd></div><div><dt>Расчётный счёт</dt><dd><%= company.bankAccount %></dd></div><div><dt>Банк</dt><dd><%= company.bank %></dd></div><div><dt>BIC</dt><dd><%= company.bic %></dd></div></dl></div>
      </div>
      <div class="contact-call-card reveal">
        <span class="eyebrow">Удобный способ связи</span>
        <div class="call-card-icon"><i class="bi bi-send" aria-hidden="true"></i></div>
        <h2>Оставьте заявку</h2>
        <p>Укажите телефон и опишите задачу. Заявка поступит специалисту производства, и он свяжется с вами для уточнения деталей.</p>
        <button class="button button-primary button-full" type="button" data-request-open><i class="bi bi-send" aria-hidden="true"></i> Открыть форму заявки</button>
        <a class="button button-secondary button-full" href="tel:<%= company.mobileHref %>"><i class="bi bi-telephone" aria-hidden="true"></i> <%= company.mobile %></a>
        <small><%= company.mobileName %> · производство в Минске</small>
      </div>
    </div>
  </section>
</main>
<%- include('partials/footer') %>
