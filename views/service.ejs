<%- include('partials/head') %>
<%- include('partials/header') %>
<% const serviceSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': meta.canonical + '#service',
      name: service.title,
      serviceType: service.navTitle,
      description: service.description,
      image: meta.image,
      provider: { '@id': siteUrl + '/#organization' },
      areaServed: { '@type': 'Country', name: 'Беларусь' },
      url: meta.canonical
    },
    {
      '@type': 'FAQPage',
      '@id': meta.canonical + '#faq',
      mainEntity: service.faq.map((item) => ({
        '@type': 'Question',
        name: item[0],
        acceptedAnswer: { '@type': 'Answer', text: item[1] }
      }))
    }
  ]
}; %>
<script type="application/ld+json"><%- safeJsonLd(serviceSchema) %></script>
<main id="main">
  <section class="service-hero">
    <div class="service-hero-media"><img src="<%= service.image %>" alt="<%= service.imageAlt %>" width="<%= service.image === '/images/hero-gears.jpg' ? 1672 : 1536 %>" height="<%= service.image === '/images/hero-gears.jpg' ? 941 : 1024 %>" fetchpriority="high"></div>
    <div class="container service-hero-inner">
      <div class="service-hero-copy reveal">
        <nav class="breadcrumbs" aria-label="Хлебные крошки"><a href="/">Главная</a><i class="bi bi-chevron-right" aria-hidden="true"></i><a href="/services/">Услуги</a><i class="bi bi-chevron-right" aria-hidden="true"></i><span><%= service.navTitle %></span></nav>
        <span class="eyebrow light">Изготовление по чертежу и образцу</span>
        <h1><%= service.title %></h1>
        <p><%= service.lead %></p>
        <div class="hero-actions"><a class="button button-primary" href="tel:<%= company.mobileHref %>">Позвонить для расчёта <i class="bi bi-telephone" aria-hidden="true"></i></a></div>
      </div>
    </div>
  </section>

  <section class="service-quickbar">
    <div class="container">
      <span><i class="bi bi-file-earmark-ruled" aria-hidden="true"></i> По чертежу, эскизу или образцу</span>
      <span><i class="bi bi-box-seam" aria-hidden="true"></i> Единичные и серийные заказы</span>
      <span><i class="bi bi-geo-alt" aria-hidden="true"></i> Производство в Минске</span>
    </div>
  </section>

  <section class="section service-overview">
    <div class="container two-column">
      <div class="reveal"><span class="eyebrow">Возможности</span><h2>Что можем <span>изготовить</span></h2><p><%= service.overview %></p><ul class="check-list"><% service.capabilities.forEach((item) => { %><li><i class="bi bi-check2" aria-hidden="true"></i><%= item %></li><% }) %></ul></div>
      <div class="spec-card reveal">
        <span class="spec-icon"><i class="bi <%= service.icon %>" aria-hidden="true"></i></span>
        <h2>Параметры заказа</h2>
        <dl><% service.details.forEach((item) => { %><div><dt><%= item[0] %></dt><dd><%= item[1] %></dd></div><% }) %></dl>
        <a class="button button-primary button-full" href="tel:<%= company.mobileHref %>">Обсудить параметры по телефону</a>
      </div>
    </div>
  </section>

  <section class="section service-context-section">
    <div class="container service-context-grid">
      <div class="context-card reveal">
        <span class="eyebrow">Применение</span>
        <h2>Для каких задач</h2>
        <ul><% service.applications.forEach((item) => { %><li><i class="bi bi-arrow-right-short" aria-hidden="true"></i><%= item %></li><% }) %></ul>
      </div>
      <div class="context-card reveal">
        <span class="eyebrow">Расчёт заказа</span>
        <h2>Что влияет на цену и срок</h2>
        <ul><% service.pricingFactors.forEach((item) => { %><li><i class="bi bi-arrow-right-short" aria-hidden="true"></i><%= item %></li><% }) %></ul>
      </div>
    </div>
  </section>

  <section class="dark-panel-section">
    <div class="container">
      <div class="section-heading light reveal"><div><span class="eyebrow light">Порядок работы</span><h2>От задачи до <span>готовой детали</span></h2></div><p>Чем полнее исходные данные, тем точнее первичный расчёт.</p></div>
      <div class="mini-process">
        <div class="reveal"><span>01</span><i class="bi bi-paperclip" aria-hidden="true"></i><h3>Получаем данные</h3><p>Чертёж, модель, фото или образец.</p></div>
        <div class="reveal"><span>02</span><i class="bi bi-rulers" aria-hidden="true"></i><h3>Уточняем параметры</h3><p>Материал, допуски, количество и срок.</p></div>
        <div class="reveal"><span>03</span><i class="bi bi-gear-wide-connected" aria-hidden="true"></i><h3>Изготавливаем</h3><p>Выполняем согласованные операции.</p></div>
        <div class="reveal"><span>04</span><i class="bi bi-shield-check" aria-hidden="true"></i><h3>Контролируем</h3><p>Проверяем размеры и передаём заказ.</p></div>
      </div>
    </div>
  </section>

  <section class="section faq-section">
    <div class="container two-column faq-layout">
      <div class="faq-intro reveal"><span class="eyebrow">Полезно знать</span><h2>Частые <span>вопросы</span></h2><p>Не нашли ответ? Позвоните или пришлите техническое задание — разберём конкретную задачу.</p><a class="text-link" href="/contacts/">Контакты производства <i class="bi bi-arrow-right" aria-hidden="true"></i></a></div>
      <div class="accordion" data-accordion>
        <% service.faq.forEach((item, index) => { %>
          <details class="reveal" <%= index === 0 ? 'open' : '' %>><summary><%= item[0] %><i class="bi bi-plus-lg" aria-hidden="true"></i></summary><div><p><%= item[1] %></p></div></details>
        <% }) %>
      </div>
    </div>
  </section>

  <section class="section related-services-section">
    <div class="container">
      <div class="section-heading reveal"><div><span class="eyebrow">Смежные операции</span><h2>Другие <span>услуги</span></h2></div><a class="text-link" href="/services/">Все услуги <i class="bi bi-arrow-right" aria-hidden="true"></i></a></div>
      <div class="related-services-grid">
        <% relatedServices.forEach((item) => { %>
          <a class="related-service-card reveal" href="/services/<%= item.slug %>/"><span><i class="bi <%= item.icon %>" aria-hidden="true"></i><%= item.shortTitle %></span><i class="bi bi-arrow-up-right" aria-hidden="true"></i></a>
        <% }) %>
      </div>
    </div>
  </section>

  <section class="cta-section compact">
    <div class="cta-media"><img src="<%= service.image %>" alt="" width="<%= service.image === '/images/hero-gears.jpg' ? 1672 : 1536 %>" height="<%= service.image === '/images/hero-gears.jpg' ? 941 : 1024 %>" loading="lazy" decoding="async" aria-hidden="true"></div>
    <div class="container cta-inner reveal"><span class="eyebrow light">Прямой контакт</span><h2>Позвоните и обсудите задачу</h2><p>Евгений уточнит, какие данные нужны для расчёта стоимости и срока.</p><div><a class="button button-primary" href="tel:<%= company.mobileHref %>"><i class="bi bi-telephone" aria-hidden="true"></i> <%= company.mobile %></a></div></div>
  </section>
</main>
<%- include('partials/footer') %>
