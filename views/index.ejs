<%- include('partials/head') %>
<%- include('partials/header') %>
<main id="main">
  <section class="hero home-hero">
    <div class="hero-media" aria-hidden="true"><img src="/images/hero-gears.jpg" alt="" width="1728" height="972" fetchpriority="high"></div>
    <div class="container hero-inner">
      <div class="hero-copy reveal">
        <span class="eyebrow light"><i class="bi bi-geo-alt" aria-hidden="true"></i> Производство в Минске</span>
        <h1><span class="hero-title-line hero-title-white">Изготовление</span><span class="hero-title-line"><b>деталей</b> любой</span><span class="hero-title-line">сложности</span></h1>
        <p>Производим запасные части к машинам и механизмам по чертежам, эскизам и образцам заказчика.</p>
        <div class="hero-actions">
          <button class="button button-primary" type="button" data-open-request>Рассчитать заказ <i class="bi bi-arrow-right" aria-hidden="true"></i></button>
          <a class="button button-ghost" href="/services">Смотреть услуги</a>
        </div>
        <div class="hero-contact"><span>Обсудить задачу:</span><a href="tel:<%= company.phoneHref %>"><%= company.phone %> — <%= company.phoneName %></a></div>
      </div>
    </div>
  </section>

  <section class="trust-strip" aria-label="Преимущества">
    <div class="container trust-grid">
      <div><i class="bi bi-shield-check" aria-hidden="true"></i><span><strong>Контроль</strong><small>Проверяем критичные размеры</small></span></div>
      <div><i class="bi bi-file-earmark-ruled" aria-hidden="true"></i><span><strong>По чертежу</strong><small>Работаем с КД, эскизом и 3D</small></span></div>
      <div><i class="bi bi-box-seam" aria-hidden="true"></i><span><strong>От одной детали</strong><small>Единичные и серийные заказы</small></span></div>
      <div><i class="bi bi-truck" aria-hidden="true"></i><span><strong>В срок</strong><small>Согласуем производство и поставку</small></span></div>
    </div>
  </section>

  <section class="section services-section" id="services">
    <div class="container">
      <div class="section-heading reveal">
        <div><span class="eyebrow">Производственные возможности</span><h2>Что мы <span>производим</span></h2></div>
        <p>Выполняем полный маршрут изготовления или отдельные технологические операции для вашей заготовки.</p>
      </div>
      <div class="service-grid">
        <% services.forEach((item, index) => { %>
          <a class="service-card reveal" href="/services/<%= item.slug %>" style="--delay:<%= index * 45 %>ms">
            <div class="service-card-media"><img src="<%= item.image %>" alt="<%= item.shortTitle %>" width="720" height="480" loading="lazy"></div>
            <div class="service-card-body">
              <span class="service-number">0<%= index + 1 %></span>
              <i class="bi <%= item.icon %>" aria-hidden="true"></i>
              <h3><%= item.shortTitle %></h3>
              <p><%= item.lead %></p>
              <span class="text-link">Подробнее <i class="bi bi-arrow-up-right" aria-hidden="true"></i></span>
            </div>
          </a>
        <% }) %>
      </div>
    </div>
  </section>

  <section class="about-section" id="about">
    <div class="container about-grid">
      <div class="about-media reveal"><img src="/images/cnc.jpg" alt="Фрезерная обработка детали на станке с ЧПУ" width="1536" height="1024" loading="lazy"><span class="media-note"><i class="bi bi-check2-circle" aria-hidden="true"></i> Производим по документации заказчика</span></div>
      <div class="about-copy reveal">
        <span class="eyebrow light">О компании</span>
        <h2>Детали, которые возвращают оборудование в работу</h2>
        <p><%= company.legalName %> производит запасные части и технологическую оснастку для промышленных машин и механизмов.</p>
        <p>Подбираем маршрут под конкретную задачу: ЧПУ-обработка, зубонарезание, электроэрозия, гибка и шлифование.</p>
        <div class="capability-numbers">
          <div><strong>Ø 1500</strong><span>мм — цилиндрические шестерни</span></div>
          <div><strong>16</strong><span>мм — модуль прямого и косого зуба</span></div>
          <div><strong>6000</strong><span>мм — максимальная длина валов</span></div>
        </div>
        <a class="button button-outline-light" href="/contacts">Связаться с производством</a>
      </div>
    </div>
  </section>

  <section class="section process-section" id="process">
    <div class="container">
      <div class="section-heading centered reveal"><div><span class="eyebrow">Понятный процесс</span><h2>Как мы <span>работаем</span></h2></div><p>От первого файла до готовой детали — с согласованием ключевых параметров.</p></div>
      <ol class="process-grid">
        <li class="reveal"><span class="process-icon"><i class="bi bi-send" aria-hidden="true"></i></span><span class="step">01</span><h3>Заявка</h3><p>Вы присылаете чертёж, эскиз, модель или фото образца.</p></li>
        <li class="reveal"><span class="process-icon"><i class="bi bi-calculator" aria-hidden="true"></i></span><span class="step">02</span><h3>Расчёт</h3><p>Уточняем материал, количество, допуски и срок.</p></li>
        <li class="reveal"><span class="process-icon"><i class="bi bi-gear-wide-connected" aria-hidden="true"></i></span><span class="step">03</span><h3>Производство</h3><p>Запускаем согласованный технологический маршрут.</p></li>
        <li class="reveal"><span class="process-icon"><i class="bi bi-shield-check" aria-hidden="true"></i></span><span class="step">04</span><h3>Контроль</h3><p>Проверяем критичные размеры и комплектность.</p></li>
        <li class="reveal"><span class="process-icon"><i class="bi bi-truck" aria-hidden="true"></i></span><span class="step">05</span><h3>Передача</h3><p>Согласуем удобный способ получения заказа.</p></li>
      </ol>
    </div>
  </section>

  <section class="cta-section">
    <div class="cta-media" aria-hidden="true"><img src="/images/grinding.jpg" alt="" loading="lazy"></div>
    <div class="container cta-inner reveal">
      <span class="eyebrow light">Начнём с расчёта</span>
      <h2>Нужна деталь по чертежу или образцу?</h2>
      <p>Опишите задачу и укажите удобный контакт. Для точного расчёта отправьте чертёж на e-mail.</p>
      <div><button class="button button-primary" type="button" data-open-request>Оставить заявку <i class="bi bi-arrow-right" aria-hidden="true"></i></button><a href="mailto:<%= company.email %>"><i class="bi bi-envelope" aria-hidden="true"></i> <%= company.email %></a></div>
    </div>
  </section>

  <section class="section contacts-preview">
    <div class="container">
      <div class="section-heading reveal"><div><span class="eyebrow">Связаться</span><h2>Контакты <span>производства</span></h2></div><a class="text-link" href="/contacts">Все реквизиты <i class="bi bi-arrow-right" aria-hidden="true"></i></a></div>
      <div class="contact-cards">
        <a class="contact-card reveal" href="<%= company.addressUrl %>" target="_blank" rel="noopener noreferrer"><i class="bi bi-geo-alt" aria-hidden="true"></i><span><small>Адрес — открыть карту</small><strong><%= company.address %></strong></span></a>
        <div class="contact-card reveal"><i class="bi bi-telephone" aria-hidden="true"></i><span><small>Алексей</small><a href="tel:<%= company.phoneHref %>"><%= company.phone %></a></span></div>
        <div class="contact-card reveal"><i class="bi bi-phone" aria-hidden="true"></i><span><small>Евгений</small><a href="tel:<%= company.mobileHref %>"><%= company.mobile %></a></span></div>
        <div class="contact-card reveal"><i class="bi bi-envelope" aria-hidden="true"></i><span><small>E-mail</small><a href="mailto:<%= company.email %>"><%= company.email %></a></span></div>
      </div>
    </div>
  </section>
</main>
<%- include('partials/footer') %>
