<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="referrer" content="strict-origin-when-cross-origin">
  <meta name="format-detection" content="telephone=no">
  <title><%= meta.title %></title>
  <meta name="description" content="<%= meta.description %>">
  <meta name="robots" content="<%= meta.noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large' %>">
  <link rel="canonical" href="<%= meta.canonical %>">
  <% if (meta.redirectTarget) { %><meta http-equiv="refresh" content="0; url=<%= meta.redirectTarget %>"><% } %>
  <link rel="alternate" hreflang="ru-BY" href="<%= meta.canonical %>">
  <link rel="alternate" hreflang="x-default" href="<%= meta.canonical %>">
  <meta property="og:locale" content="ru_BY">
  <meta property="og:type" content="<%= meta.type %>">
  <meta property="og:site_name" content="СпецТехОснастка">
  <meta property="og:title" content="<%= meta.title %>">
  <meta property="og:description" content="<%= meta.description %>">
  <meta property="og:url" content="<%= meta.canonical %>">
  <meta property="og:image" content="<%= meta.image %>">
  <meta property="og:image:alt" content="<%= meta.imageAlt %>">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= meta.title %>">
  <meta name="twitter:description" content="<%= meta.description %>">
  <meta name="twitter:image" content="<%= meta.image %>">
  <meta name="twitter:image:alt" content="<%= meta.imageAlt %>">
  <meta name="theme-color" content="#07131d">
  <meta name="msapplication-TileColor" content="#07131d">
  <meta name="msapplication-config" content="/browserconfig.xml">
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" href="/images/favicon-16x16.png" type="image/png" sizes="16x16">
  <link rel="icon" href="/images/favicon-32x32.png" type="image/png" sizes="32x32">
  <link rel="icon" href="/images/favicon-48x48.png" type="image/png" sizes="48x48">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180">
  <link rel="manifest" href="/site.webmanifest">
  <% if (meta.preloadImage) { %><link rel="preload" href="<%= meta.preloadImage %>" as="image" fetchpriority="high"><% } %>
  <link rel="preload" href="/fonts/manrope-cyrillic-500-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/icons/bootstrap-icons.css">
  <link rel="stylesheet" href="/css/styles.css?v=9">
  <% const organizationId = siteUrl + '/#organization';
     const websiteId = siteUrl + '/#website';
     const graph = [
       {
         '@type': 'Organization',
         '@id': organizationId,
         name: company.legalName,
         alternateName: company.name,
         url: siteUrl + '/',
         logo: { '@type': 'ImageObject', url: siteUrl + '/images/android-chrome-512x512.png', width: 512, height: 512 },
         image: siteUrl + '/images/hero-gears.jpg',
         email: company.email,
         telephone: [company.mobileHref, company.phoneHref],
         taxID: company.unp,
         address: {
           '@type': 'PostalAddress',
           postalCode: company.postalCode,
           addressLocality: 'Минск',
           streetAddress: 'ул. Зм. Бядули, д. 13, корп. 4, пом. 214',
           addressCountry: 'BY'
         },
         areaServed: { '@type': 'Country', name: 'Беларусь' },
         knowsAbout: ['металлообработка', 'ЧПУ-обработка', 'шестерни', 'зубчатые передачи', 'пресс-формы'],
         contactPoint: [
           { '@type': 'ContactPoint', telephone: company.mobileHref, contactType: 'sales', name: company.mobileName, availableLanguage: ['ru'] },
           { '@type': 'ContactPoint', telephone: company.phoneHref, contactType: 'sales', name: company.phoneName, availableLanguage: ['ru'] }
         ]
       },
       {
         '@type': 'WebSite',
         '@id': websiteId,
         url: siteUrl + '/',
         name: company.name,
         inLanguage: 'ru-BY',
         publisher: { '@id': organizationId }
       },
       {
         '@type': 'WebPage',
         '@id': meta.canonical + '#webpage',
         url: meta.canonical,
         name: meta.title,
         description: meta.description,
         inLanguage: 'ru-BY',
         isPartOf: { '@id': websiteId },
         about: { '@id': organizationId },
         primaryImageOfPage: { '@type': 'ImageObject', url: meta.image }
       }
     ];
     if (meta.breadcrumbs.length > 1) graph.push({
       '@type': 'BreadcrumbList',
       '@id': meta.canonical + '#breadcrumb',
       itemListElement: meta.breadcrumbs.map((item, index) => ({
         '@type': 'ListItem', position: index + 1, name: item.name, item: item.url
       }))
     }); %>
  <% if (!meta.redirectTarget) { %><script type="application/ld+json"><%- safeJsonLd({ '@context': 'https://schema.org', '@graph': graph }) %></script><% } %>
</head>
<body>
  <a class="skip-link" href="#main">К основному содержимому</a>
