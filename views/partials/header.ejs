<header class="site-header" data-header>
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="СпецТехОснастка — главная">
      <span class="brand-mark"><i class="bi bi-gear-wide-connected" aria-hidden="true"></i></span>
      <span class="brand-copy"><strong>СпецТехОснастка</strong><small>Точное производство деталей</small></span>
    </a>
    <nav class="desktop-nav" aria-label="Основная навигация">
      <a class="<%= currentPath === '/' ? 'active' : '' %>" href="/">Главная</a>
      <a class="<%= currentPath.startsWith('/services') ? 'active' : '' %>" href="/services/">Услуги</a>
      <a href="/#about">О компании</a>
      <a href="/#process">Как работаем</a>
      <a class="<%= currentPath === '/contacts' ? 'active' : '' %>" href="/contacts/">Контакты</a>
    </nav>
    <div class="header-contacts">
      <a href="tel:<%= company.mobileHref %>"><i class="bi bi-telephone" aria-hidden="true"></i><span><small><%= company.mobileName %></small><strong><%= company.mobile %></strong></span></a>
    </div>
    <button class="menu-toggle" type="button" aria-label="Открыть меню" aria-expanded="false" data-menu-toggle><i class="bi bi-list" aria-hidden="true"></i></button>
  </div>
  <div class="mobile-menu" data-mobile-menu hidden>
    <nav class="container" aria-label="Мобильная навигация">
      <a href="/">Главная</a>
      <a href="/services/">Все услуги</a>
      <% services.forEach((item) => { %><a class="mobile-sub" href="/services/<%= item.slug %>/"><%= item.navTitle %></a><% }) %>
      <a href="/#about">О компании</a>
      <a href="/#process">Как работаем</a>
      <a href="/contacts/">Контакты</a>
    </nav>
  </div>
</header>
